{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@iwsdk/vite-plugin-dev/client"]
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "api/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "vite.config.ts"]
}
